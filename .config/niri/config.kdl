workspace "web"
workspace "social"
workspace "game"
workspace "misc"
workspace "system"
workspace "extra"
workspace "scratch"

input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 300
        repeat-rate 90
        numlock
    }
    touchpad { tap; dwt; }
    mouse { accel-speed 0.0; accel-profile "flat"; }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="10%"
    workspace-auto-back-and-forth
}
cursor { xcursor-size 24; }
layout {
    gaps 6
    center-focused-column "never"
    preset-column-widths { proportion 0.25; proportion 0.5; proportion 1.0; }
    default-column-width { proportion 1.0; }
    focus-ring { off; }
    border {
        width 2
    }
}
include optional=true "~/.local/state/darkman/niri.kdl"
prefer-no-csd
hotkey-overlay { skip-at-startup; }
gestures { hot-corners { off; }; }
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

spawn-at-startup "systemctl" "--user" "start" "darkman.service"
spawn-at-startup "systemctl" "--user" "restart" "xdg-desktop-portal.service" "xdg-desktop-portal-gtk.service" "xdg-desktop-portal-gnome.service"

spawn-at-startup "/home/evan/.local/bin/display-mode" "--watch"
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
spawn-at-startup "systemctl" "--user" "start" "swaync.service"
spawn-at-startup "systemctl" "--user" "restart" "yubikey-touch-detector.service"
spawn-at-startup "waybar" "--config" "/home/evan/.config/waybar/niri.jsonc"
spawn-at-startup "swayosd-server"
spawn-at-startup "/home/evan/.local/bin/scapectl"
spawn-at-startup "steam" "-silent"
spawn-at-startup "discord"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "/home/evan/.local/bin/desktopctl" "idle"

window-rule {
    match app-id="^foot$"
    default-column-width { proportion 0.5; }
}
window-rule {
    match app-id="(?i)^(firefox|org\\.mozilla\\.firefox|librewolf|com\\.brave\\.Browser|brave-browser|org\\.qutebrowser\\.qutebrowser|qutebrowser)$"
    exclude title="^Picture-in-Picture$"
    open-on-workspace "web"
}
window-rule {
    match app-id="(?i)^(discord|com\\.discordapp\\.Discord)$"
    open-on-workspace "social"
}
window-rule {
    match app-id="^org\\.gnome\\.World\\.PikaBackup$"
    match app-id="^dev\\.deedles\\.Trayscale$"
    open-on-workspace "system"
}
window-rule {
    match app-id="(?i)^steam$" title="^(Steam|Friends List)$"
    match app-id="^steam_app_[0-9]+$"
    match app-id="^steam_app_default$" title="(?i)^Battle\\.net"
    match app-id="(?i)(faugus|battle\\.net)"
    open-on-workspace "game"
}
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="(?i)^steam$" title="^notificationtoasts_[0-9]+_desktop$"
    open-floating true
    open-focused false
    default-floating-position x=10 y=10 relative-to="bottom-right"
}
window-rule {
    match app-id="^(org\\.gnome\\.Nautilus|nautilus)$"
    open-floating true
    default-column-width { fixed 1400; }
    default-window-height { fixed 900; }
}
window-rule {
    match app-id="^dev\\.deedles\\.Trayscale$"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 620; }
}
window-rule {
    match app-id="^mpv$"
    open-floating true
    default-column-width { fixed 1920; }
    default-window-height { fixed 1080; }
}
window-rule {
    match app-id="^swayimg$"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 800; }
}
window-rule {
    match app-id="^(org\\.pulseaudio\\.pavucontrol|pavucontrol)$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}
window-rule {
    match app-id="(?i)^steam$" title="^Friends List$"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 700; }
}
window-rule {
    match app-id="^scratch_(btop|rmpc)$"
    open-floating true
    default-column-width { fixed 1920; }
    default-window-height { fixed 1080; }
    open-on-workspace "scratch"
    open-focused false
}
binds {
    Mod+Return repeat=false { spawn "foot"; }
    Mod+Space repeat=false { spawn "fuzzel"; }
    Mod+E repeat=false { spawn "nautilus"; }
    Mod+P repeat=false { spawn "/home/evan/.local/bin/desktopctl" "power"; }
    Mod+Alt+L repeat=false { spawn "/home/evan/.local/bin/desktopctl" "lock"; }
    Mod+Ctrl+T repeat=false { spawn "/home/evan/.local/bin/desktopctl" "scratch-btop"; }
    Mod+Ctrl+R repeat=false { spawn "/home/evan/.local/bin/desktopctl" "scratch-rmpc"; }
    Mod+Ctrl+N repeat=false { spawn "swaync-client" "-t"; }
    Mod+Ctrl+B repeat=false { spawn "pkill" "-USR1" "-x" "waybar"; }
    Mod+Ctrl+M repeat=false { spawn "/home/evan/.local/bin/display-mode"; }
    Mod+Alt+V repeat=false { spawn "/home/evan/.local/bin/desktopctl" "clipboard"; }
    Mod+Shift+E repeat=false { spawn "/home/evan/.local/bin/desktopctl" "power"; }
    Ctrl+Alt+Delete repeat=false { spawn "/home/evan/.local/bin/desktopctl" "power"; }
    Mod+Alt+M { spawn-sh "~/.config/scripts/watch-media"; }
    Mod+O { toggle-overview; }
    Mod+Q { close-window; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-window; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Print { spawn "/home/evan/.local/bin/desktopctl" "screenshot" "region"; }
    Ctrl+Print { spawn "/home/evan/.local/bin/desktopctl" "screenshot" "output"; }
    Alt+Print { spawn "/home/evan/.local/bin/desktopctl" "screenshot" "window"; }
    Mod+F4 { spawn "/home/evan/.local/bin/desktopctl" "game-window"; }
    Mod+H { focus-column-left; }
    Mod+Shift+H { move-column-left; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+J { focus-window-down; }
    Mod+Shift+J { move-window-down; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    Mod+K { focus-window-up; }
    Mod+Shift+K { move-window-up; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+L { focus-column-right; }
    Mod+Shift+L { move-column-right; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }
    Mod+U { focus-workspace-down; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+U { move-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+I { move-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+Page_Down { move-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+Page_Up { move-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+1 { focus-workspace "web"; }
    Mod+Shift+1 { move-column-to-workspace "web"; }
    Mod+2 { focus-workspace "social"; }
    Mod+Shift+2 { move-column-to-workspace "social"; }
    Mod+3 { focus-workspace "game"; }
    Mod+Shift+3 { move-column-to-workspace "game"; }
    Mod+4 { focus-workspace "misc"; }
    Mod+Shift+4 { move-column-to-workspace "misc"; }
    Mod+5 { focus-workspace "system"; }
    Mod+Shift+5 { move-column-to-workspace "system"; }
    Mod+6 { focus-workspace "extra"; }
    Mod+Shift+6 { move-column-to-workspace "extra"; }
    Mod+7 { focus-workspace 7; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "swayosd-client" "--playerctl" "play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn "swayosd-client" "--playerctl" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "swayosd-client" "--playerctl" "prev"; }
    XF86AudioNext allow-when-locked=true { spawn "swayosd-client" "--playerctl" "next"; }
}
