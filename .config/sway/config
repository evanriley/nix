set $mod Mod4
set $term foot
set $menu fuzzel
set $tools ~/.local/bin/desktopctl
font pango:Berkeley Mono, Noto Sans 10
xwayland enable
floating_modifier $mod normal
focus_follows_mouse yes
mouse_warping container
workspace_auto_back_and_forth yes
focus_wrapping yes
hide_edge_borders smart
smart_borders on
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 0
client.focused          #8ba4b0 #090e13 #c5c9c7 #8ba4b0 #8ba4b0
client.focused_inactive #393b44 #090e13 #a6a69c #393b44 #393b44
client.unfocused        #1f1f28 #090e13 #a6a69c #1f1f28 #1f1f28
client.urgent           #c4746e #c4746e #090e13 #c4746e #c4746e
output * bg #090e13 solid_color
input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 90
    xkb_numlock enabled
}
input type:pointer {
    accel_profile flat
    pointer_accel 0
}
input type:touchpad {
    tap enabled
    dwt enabled
}
include ~/.local/state/darkman/sway.conf
exec ~/.local/bin/sway-session-start

set $ws1 1:web
set $ws2 2:social
set $ws3 3:game
set $ws4 4:misc
set $ws5 5:system
set $ws6 6:extra

assign [app_id="(?i)^(firefox|org\.mozilla\.firefox|librewolf|com\.brave\.Browser|brave-browser|org\.qutebrowser\.qutebrowser|qutebrowser)$" title="^(?!Picture-in-Picture$)"] workspace $ws1
assign [class="(?i)^(firefox|librewolf|brave-browser|qutebrowser)$" title="^(?!Picture-in-Picture$)"] workspace $ws1
assign [app_id="(?i)^(discord|com\.discordapp\.Discord)$"] workspace $ws2
assign [class="(?i)^(discord|com\.discordapp\.Discord)$"] workspace $ws2
assign [app_id="org.gnome.World.PikaBackup"] workspace $ws5
assign [app_id="dev.deedles.Trayscale"] workspace $ws5

assign [class="(?i)^steam$" title="^(Steam|Friends List)$"] workspace $ws3
assign [app_id="(?i)^steam$" title="^(Steam|Friends List)$"] workspace $ws3
assign [class="^steam_app_[0-9]+$"] workspace $ws3
assign [app_id="^steam_app_[0-9]+$"] workspace $ws3
assign [class="^steam_app_default$" title="(?i)^Battle\.net"] workspace $ws3
for_window [class="(?i)^steam$" title="^Friends List$"] floating enable, resize set width 600 px height 700 px
for_window [app_id="(?i)^steam$" title="^Friends List$"] floating enable, resize set width 600 px height 700 px
for_window [class="(?i)^steam$" title="^notificationtoasts_[0-9]+_desktop$"] floating enable
for_window [app_id="(?i)^steam$" title="^notificationtoasts_[0-9]+_desktop$"] floating enable
no_focus [class="(?i)^steam$" title="^notificationtoasts_[0-9]+_desktop$"]
no_focus [app_id="(?i)^steam$" title="^notificationtoasts_[0-9]+_desktop$"]

for_window [app_id="(?i)(firefox|librewolf)$" title="^Picture-in-Picture$"] floating enable
for_window [class="(?i)(firefox|librewolf)$" title="^Picture-in-Picture$"] floating enable
for_window [app_id="^(org\.gnome\.Nautilus|nautilus)$"] floating enable, resize set width 1400 px height 900 px, move position center
for_window [app_id="^dev\.deedles\.Trayscale$"] floating enable, resize set width 520 px height 620 px, move position center
for_window [app_id="^mpv$"] floating enable, resize set width 1920 px height 1080 px, move position center
for_window [class="^mpv$"] floating enable, resize set width 1920 px height 1080 px, move position center
for_window [app_id="^swayimg$"] floating enable, resize set width 1280 px height 800 px, move position center
for_window [app_id="^(org\.pulseaudio\.pavucontrol|pavucontrol)$"] floating enable, resize set width 800 px height 600 px, move position center
for_window [app_id="^scratch_btop$"] floating enable, move scratchpad
for_window [app_id="^scratch_rmpc$"] floating enable, move scratchpad

bindsym $mod+Return exec $term
bindsym $mod+space exec $menu
bindsym $mod+e exec nautilus
bindsym $mod+p exec $tools power
bindsym $mod+Mod1+l exec $tools lock
bindsym $mod+Ctrl+t exec $tools scratch-btop
bindsym $mod+Ctrl+r exec $tools scratch-rmpc
bindsym $mod+Ctrl+n exec swaync-client -t
bindsym $mod+Ctrl+b exec pkill -USR1 -x waybar
bindsym $mod+Ctrl+m exec ~/.local/bin/display-mode
bindsym $mod+Mod1+v exec $tools clipboard
bindsym $mod+Mod1+m exec ~/.config/scripts/watch-media
bindsym $mod+q kill
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Ctrl+h focus output left
bindsym $mod+Ctrl+j focus output down
bindsym $mod+Ctrl+k focus output up
bindsym $mod+Ctrl+l focus output right
bindsym $mod+Ctrl+Shift+h move container to output left
bindsym $mod+Ctrl+Shift+j move container to output down
bindsym $mod+Ctrl+Shift+k move container to output up
bindsym $mod+Ctrl+Shift+l move container to output right
bindsym $mod+w layout toggle tabbed splith
bindsym $mod+b splith
bindsym $mod+Shift+b splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+v floating toggle
bindsym $mod+Shift+v focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child
bindsym $mod+minus resize shrink width 10 ppt
bindsym $mod+equal resize grow width 10 ppt
bindsym $mod+Shift+minus resize shrink height 10 ppt
bindsym $mod+Shift+equal resize grow height 10 ppt
bindsym $mod+c move position center
bindsym --whole-window $mod+button5 workspace next
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+Ctrl+button5 move container to workspace next
bindsym --whole-window $mod+Ctrl+button4 move container to workspace prev
bindsym --whole-window $mod+button7 focus right
bindsym --whole-window $mod+button6 focus left
bindsym --whole-window $mod+Ctrl+button7 move right
bindsym --whole-window $mod+Ctrl+button6 move left
bindsym --whole-window $mod+Shift+button5 focus right
bindsym --whole-window $mod+Shift+button4 focus left
bindsym --whole-window $mod+Ctrl+Shift+button5 move right
bindsym --whole-window $mod+Ctrl+Shift+button4 move left
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 10 ppt
    bindsym j resize grow height 10 ppt
    bindsym k resize shrink height 10 ppt
    bindsym l resize grow width 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+r reload
bindsym $mod+u workspace next
bindsym $mod+i workspace prev
bindsym $mod+Page_Down workspace next
bindsym $mod+Page_Up workspace prev
bindsym $mod+Shift+u move container to workspace next
bindsym $mod+Shift+i move container to workspace prev
bindsym $mod+Shift+Page_Down move container to workspace next
bindsym $mod+Shift+Page_Up move container to workspace prev
bindsym $mod+1 workspace number $ws1
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+F4 floating enable, resize set width 3840 px height 2160 px, move position center

bindsym --release Print exec $tools screenshot region
bindsym --release Ctrl+Print exec $tools screenshot output
bindsym --release Mod1+Print exec $tools screenshot window
bindsym $mod+Shift+e exec $tools power
bindsym Ctrl+Mod1+Delete exec $tools power
bindsym --locked XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym --locked XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym --locked XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym --locked XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
bindsym --locked XF86AudioPlay exec swayosd-client --playerctl play-pause
bindsym --locked XF86AudioStop exec swayosd-client --playerctl stop
bindsym --locked XF86AudioPrev exec swayosd-client --playerctl prev
bindsym --locked XF86AudioNext exec swayosd-client --playerctl next

exec_always ~/.local/bin/display-mode --watch

exec /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
exec systemctl --user restart yubikey-touch-detector.service
exec waybar
exec nm-applet --indicator
exec blueman-applet
exec steam -silent
exec sh -c 'command -v discord >/dev/null 2>&1 && exec discord'
exec swayosd-server
exec sh -c 'command -v scapectl >/dev/null 2>&1 && exec scapectl'
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec $tools idle
