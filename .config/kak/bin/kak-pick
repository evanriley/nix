#!/bin/sh
# kak-pick <files|git|recent|grep> <session> <client> <root> [<recent-file>|<query>]
# Runs fzf (inside a tmux popup) and opens the choice in the Kakoune client that asked.
mode=$1 session=$2 client=$3 root=$4 extra=$5
cd "$root" || exit 1

kq() { printf "'%s'" "$(printf %s "$1" | sed "s/'/''/g")"; }
open() { # <path> [<line> [<column>]]
    command="edit -existing $(kq "$1") $2 $3"
    printf 'evaluate-commands -client %s %s\n' "$(kq "$client")" "$(kq "$command")" |
        kak -p "$session"
}

if command -v bat >/dev/null; then
    preview='bat --color=always --style=numbers --line-range=:300 -- {}'
    grep_preview='bat --color=always --style=numbers --highlight-line {2} -- {1}'
else
    preview='head -300 -- {}'
    grep_preview='head -300 -- {1}'
fi
fzf_options='--height=100% --layout=reverse --info=inline-right --preview-window=right,55%,border-left'

case $mode in
    files)
        fd --type f --hidden --exclude .git --follow --strip-cwd-prefix |
            fzf $fzf_options --multi --prompt='files> ' --preview "$preview" ;;
    git)
        git ls-files --cached --others --exclude-standard |
            fzf $fzf_options --multi --prompt='git> ' --preview "$preview" ;;
    recent)
        [ -r "$extra" ] || exit 0
        while IFS= read -r path; do [ -f "$path" ] && printf '%s\n' "$path"; done < "$extra" |
            fzf $fzf_options --multi --prompt='recent> ' --preview "$preview" ;;
    grep)
        rg='rg --line-number --column --no-heading --color=always --smart-case --'
        : | fzf $fzf_options --multi --disabled --ansi --prompt='grep> ' --query "$extra" \
            --delimiter : --bind "start:reload:$rg {q} . || true" \
            --bind "change:reload:sleep 0.05; $rg {q} . || true" \
            --preview "$grep_preview" --preview-window '+{2}/3' ;;
esac | while IFS= read -r choice; do
    case $mode in
        grep)
            file=${choice%%:*}; rest=${choice#*:}
            line=${rest%%:*}; rest=${rest#*:}
            column=${rest%%:*}
            case $file in /*) ;; *) file=$root/$file;; esac
            open "$file" "$line" "$column" ;;
        recent) open "$choice" ;;
        *) open "$root/$choice" ;;
    esac
done
