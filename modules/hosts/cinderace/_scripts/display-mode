#!/usr/bin/env python3
"""Match the Odyssey G80HS to its current hardware mode under niri or umbriel.

The monitor exposes either its 6K or its 3K mode list depending on a physical
switch. This picks 6144x3456@165 (scale 2) or 3072x1728@330 (scale 1, with a
240 Hz fallback) from whatever is advertised.
"""

import argparse
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time

def choose_mode(output):
    if output.get("model") != "Odyssey G80HS" or not output.get("active"):
        return None
    if output.get("power") is False or output.get("dpms") is False:
        return None
    for width, height, refresh, scale in [(3072, 1728, 330000, 1),
                                           (3072, 1728, 240000, 1),
                                           (6144, 3456, 165000, 2)]:
        modes = [m for m in output.get("modes", [])
                 if m["width"] == width and m["height"] == height
                 and abs(m["refresh"] - refresh) < 1000]
        if modes:
            return max(modes, key=lambda m: m["refresh"]), scale
    return None

def needs_power_cycle(mode):
    """The G80HS needs to be off before a modeset into 330 Hz."""
    return mode["width"] == 3072 and mode["refresh"] > 329000

def timing(mode):
    return f'{mode["width"]}x{mode["height"]}@{mode["refresh"] / 1000:.3f}'

# niri blocks IPC for ~6 s during the 330 Hz modeset.
NIRI_TIMEOUT = 30

def niri_command(name, action, value):
    result = subprocess.run(["niri", "msg", "--json", "output", name, action, str(value)],
                            check=True, capture_output=True, text=True, timeout=NIRI_TIMEOUT)
    if "OutputWasMissing" in result.stdout:
        raise RuntimeError(f"Niri output disappeared: {name}")

def niri_power(state):
    subprocess.run(["niri", "msg", "action", f"power-{state}-monitors"],
                   check=True, capture_output=True, text=True, timeout=NIRI_TIMEOUT)

def niri_outputs(outputs):
    normalized = []
    for output in outputs.values():
        modes = [dict(width=m["width"], height=m["height"], refresh=m["refresh_rate"])
                 for m in output["modes"]]
        index = output.get("current_mode")
        logical = output.get("logical") or {}
        normalized.append(dict(name=output["name"], model=output["model"],
                               active=index is not None and bool(logical), modes=modes,
                               current_mode=modes[index] if index is not None else None,
                               scale=logical.get("scale")))
    return normalized

def set_niri_output(output, mode, scale, dry_run):
    current = output["current_mode"]
    changes = [("mode", timing(mode))]
    if scale != output["scale"]:
        changes.append(("scale", scale))
    # Use DPMS rather than output off/on, which would remove its workspaces.
    power_cycle = needs_power_cycle(mode)
    if dry_run:
        if power_cycle:
            print("niri msg action power-off-monitors")
            print("# wait 2 seconds")
        for action, value in changes:
            print(f'niri msg output {output["name"]} {action} {value}')
        if power_cycle:
            print("niri msg action power-on-monitors")
        return
    try:
        if power_cycle:
            niri_power("off")
            time.sleep(2)
        for action, value in changes:
            niri_command(output["name"], action, value)
    except BaseException:
        if power_cycle and current:
            try:
                niri_command(output["name"], "mode", timing(current))
                niri_command(output["name"], "scale", output["scale"])
            except Exception as error:
                print(f"display-mode: recovery failed: {error}", file=sys.stderr, flush=True)
        raise
    finally:
        if power_cycle:
            niri_power("on")

def wlr_randr(*args, dry_run=False):
    if dry_run:
        print("wlr-randr " + " ".join(args))
        return None
    return subprocess.run(["wlr-randr", *args], check=True, capture_output=True, text=True,
                          timeout=30).stdout

def umbriel_outputs():
    normalized = []
    for output in json.loads(wlr_randr("--json")):
        modes = [dict(width=m["width"], height=m["height"], refresh=round(m["refresh"] * 1000))
                 for m in output["modes"]]
        current = next((mode for mode, raw in zip(modes, output["modes"]) if raw.get("current")),
                       None)
        normalized.append(dict(name=output["name"], model=output["model"],
                               active=output["enabled"] and current is not None, modes=modes,
                               current_mode=current, scale=output["scale"]))
    return normalized

def set_umbriel_output(output, mode, scale, dry_run):
    name = output["name"]
    settings = ["--mode", timing(mode), "--scale", str(scale)]
    if not needs_power_cycle(mode):
        wlr_randr("--output", name, *settings, dry_run=dry_run)
        return
    # umbriel rejects output changes while DPMS is off, but restores the
    # output's workspaces after a disable and enable.
    wlr_randr("--output", name, "--off", dry_run=dry_run)
    if dry_run:
        print("# wait 2 seconds")
    else:
        time.sleep(2)
    try:
        wlr_randr("--output", name, "--on", *settings, dry_run=dry_run)
    except BaseException:
        try:
            wlr_randr("--output", name, "--on", "--mode", timing(output["current_mode"]),
                      "--scale", str(output["scale"]))
        except Exception as error:
            print(f"display-mode: recovery failed: {error}", file=sys.stderr, flush=True)
        raise

def apply_outputs(outputs, set_output, dry_run):
    for output in outputs:
        selected = choose_mode(output)
        if selected is None:
            continue
        mode, scale = selected
        if mode != output["current_mode"] or scale != output["scale"]:
            set_output(output, mode, scale, dry_run)
            print(f"display-mode: {timing(mode)}Hz, scale {scale}", flush=True)

def niri_reader(path):
    sock = socket.socket(socket.AF_UNIX)
    sock.settimeout(5)
    sock.connect(path)
    stream = sock.makefile("rb")

    def read():
        sock.sendall(b'"Outputs"\n')
        line = stream.readline()
        if not line:
            raise EOFError
        reply = json.loads(line)
        if "Err" in reply:
            raise RuntimeError(reply["Err"])
        return niri_outputs(reply["Ok"]["Outputs"])
    return read

def watch_outputs(read_outputs, set_output, watch, dry_run):
    # Written by swayidle while the monitors are powered off.
    paused = Path(os.environ["XDG_RUNTIME_DIR"]) / "monitors-off"
    while True:
        try:
            outputs = read_outputs()
            if not paused.exists():
                apply_outputs(outputs, set_output, dry_run)
        except (subprocess.SubprocessError, RuntimeError, ValueError) as error:
            if not watch:
                raise
            print(f"display-mode: {error}", file=sys.stderr, flush=True)
        if not watch:
            return 0
        time.sleep(3)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--watch", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        if os.environ.get("NIRI_SOCKET"):
            return watch_outputs(niri_reader(os.environ["NIRI_SOCKET"]), set_niri_output,
                                 args.watch, args.dry_run)
        if os.environ.get("UMBRIEL_SOCKET"):
            return watch_outputs(umbriel_outputs, set_umbriel_output, args.watch, args.dry_run)
        raise RuntimeError("no niri or umbriel session; expected NIRI_SOCKET or UMBRIEL_SOCKET")
    except (EOFError, BrokenPipeError, ConnectionResetError):
        return 0 if args.watch else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, KeyError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"display-mode: {error}", file=sys.stderr)
        sys.exit(1)
