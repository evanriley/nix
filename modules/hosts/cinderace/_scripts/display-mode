#!/usr/bin/env python3
"""Match the Odyssey G80HS to its current hardware mode under umbriel.

The monitor exposes either its 6K or its 3K mode list depending on a physical
switch. This picks 6144x3456@165 (scale 2) or 3072x1728@330 (scale 1, with a
240 Hz fallback) from whatever is advertised.
"""

import argparse
import json
import os
import subprocess
import sys
import time

def choose_mode(output):
    if output.get("model") != "Odyssey G80HS" or not output.get("active"):
        return None
    if output.get("power") is False or output.get("dpms") is False:
        return None
    for width, height, refresh, scale in [(3072, 1728, 330000, 1),
                                           (3072, 1728, 240000, 1),
                                           (6144, 3456, 165000, 2)]:
        modes = [m for m in output.get("modes", [])
                 if m["width"] == width and m["height"] == height
                 and abs(m["refresh"] - refresh) < 1000]
        if modes:
            return max(modes, key=lambda m: m["refresh"]), scale
    return None

def needs_power_cycle(mode):
    """The G80HS needs to be off before a modeset into 330 Hz."""
    return mode["width"] == 3072 and mode["refresh"] > 329000

def timing(mode):
    return f'{mode["width"]}x{mode["height"]}@{mode["refresh"] / 1000:.3f}'

def wlr_randr(*args, dry_run=False):
    if dry_run:
        print("wlr-randr " + " ".join(args))
        return None
    return subprocess.run(["wlr-randr", *args], check=True, capture_output=True, text=True,
                          timeout=30).stdout

def umbriel_outputs():
    normalized = []
    for output in json.loads(wlr_randr("--json")):
        modes = [dict(width=m["width"], height=m["height"], refresh=round(m["refresh"] * 1000))
                 for m in output["modes"]]
        current = next((mode for mode, raw in zip(modes, output["modes"]) if raw.get("current")),
                       None)
        normalized.append(dict(name=output["name"], model=output["model"],
                               active=output["enabled"] and current is not None, modes=modes,
                               current_mode=current, scale=output["scale"]))
    return normalized

def set_umbriel_output(output, mode, scale, dry_run):
    name = output["name"]
    settings = ["--mode", timing(mode), "--scale", str(scale)]
    if not needs_power_cycle(mode):
        wlr_randr("--output", name, *settings, dry_run=dry_run)
        return
    # umbriel rejects output changes while DPMS is off, but restores the
    # output's workspaces after a disable and enable.
    wlr_randr("--output", name, "--off", dry_run=dry_run)
    if dry_run:
        print("# wait 2 seconds")
    else:
        time.sleep(2)
    try:
        wlr_randr("--output", name, "--on", *settings, dry_run=dry_run)
    except BaseException:
        try:
            wlr_randr("--output", name, "--on", "--mode", timing(output["current_mode"]),
                      "--scale", str(output["scale"]))
        except Exception as error:
            print(f"display-mode: recovery failed: {error}", file=sys.stderr, flush=True)
        raise

def apply_outputs(outputs, set_output, dry_run):
    for output in outputs:
        selected = choose_mode(output)
        if selected is None:
            continue
        mode, scale = selected
        if mode != output["current_mode"] or scale != output["scale"]:
            set_output(output, mode, scale, dry_run)
            print(f"display-mode: {timing(mode)}Hz, scale {scale}", flush=True)

def watch_outputs(read_outputs, set_output, watch, dry_run):
    while True:
        try:
            apply_outputs(read_outputs(), set_output, dry_run)
        except (subprocess.SubprocessError, RuntimeError, ValueError) as error:
            if not watch:
                raise
            print(f"display-mode: {error}", file=sys.stderr, flush=True)
        if not watch:
            return 0
        time.sleep(3)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--watch", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if not os.environ.get("UMBRIEL_SOCKET"):
        raise RuntimeError("no umbriel session; expected UMBRIEL_SOCKET")
    return watch_outputs(umbriel_outputs, set_umbriel_output, args.watch, args.dry_run)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, KeyError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"display-mode: {error}", file=sys.stderr)
        sys.exit(1)
