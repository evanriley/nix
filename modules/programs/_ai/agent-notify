#!/usr/bin/env bash
# Claude Code Notification and Stop hook: desktop notification with the project name.
set -euo pipefail

input=$(cat)
event=$(jq -r '.hook_event_name // empty' <<<"$input")
project=$(basename "$(jq -r '.cwd // empty' <<<"$input")")
app=$(jq -r '.app // "Claude Code"' <<<"$input")
message=$(jq -r '.message // empty' <<<"$input")
[ -n "$message" ] || message="Finished"
[ "$event" = Stop ] && message="Finished"

title="$app: $project"
if [ "$(uname)" = Darwin ]; then
  /usr/bin/osascript - "$title" "$message" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
else
  notify-send --app-name "$app" "$title" "$message" 2>/dev/null || true
fi
