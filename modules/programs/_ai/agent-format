#!/usr/bin/env bash
# Claude Code PostToolUse hook: format the edited file. Language formatters run only
# when the project's dev shell provides them, so projects without one are untouched.
set -uo pipefail

file=$(jq -r '.tool_input.file_path // empty')
[ -f "$file" ] || exit 0

has() { command -v "$1" >/dev/null 2>&1; }

nearest() {
  local directory
  directory=$(dirname "$file")
  while [ "$directory" != / ]; do
    [ -e "$directory/$1" ] && { echo "$directory/$1"; return 0; }
    directory=$(dirname "$directory")
  done
  return 1
}

status=0
case "$file" in
  *.nix) nixfmt --quiet "$file" ;;
  *.py | *.pyi) if has ruff; then ruff format --quiet "$file"; fi ;;
  *.clj | *.cljs | *.cljc | *.edn | *.bb) if has cljfmt; then cljfmt fix --quiet "$file"; fi ;;
  *.ml | *.mli) if has ocamlformat && nearest .ocamlformat >/dev/null; then ocamlformat --inplace "$file"; fi ;;
  *.rs)
    if has rustfmt; then
      edition=2021
      if manifest=$(nearest Cargo.toml); then
        edition=$(sed -n 's/^edition *= *"\([0-9]*\)".*/\1/p' "$manifest" | head -n1)
        edition=${edition:-2021}
      fi
      rustfmt --edition "$edition" "$file"
    fi
    ;;
  *.gleam) if has gleam; then gleam format "$file"; fi ;;
  *.zig) if has zig; then zig fmt "$file"; fi ;;
esac >/dev/null 2>&1 || status=$?

if [ "$status" -ne 0 ]; then
  printf 'Formatter failed for %s (exit %s). The edit was kept; fix formatting before verification.\n' "$file" "$status" >&2
fi

exit 0
