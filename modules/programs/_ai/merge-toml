#!/usr/bin/env python3
import os
import sys
import tempfile
from collections.abc import MutableMapping
from pathlib import Path

import tomlkit
from tomlkit.exceptions import TOMLKitError
from tomlkit.toml_document import TOMLDocument


class ParseError(Exception):
    pass


def parse(path: Path) -> TOMLDocument:
    try:
        return tomlkit.parse(path.read_text(encoding="utf-8"))
    except TOMLKitError as error:
        raise ParseError(
            f"Failed to parse {path}; expected valid TOML. "
            f"Fix or remove {path}, then switch again. ({error})"
        ) from error


def merge(
    target: MutableMapping[str, object], managed: MutableMapping[str, object]
) -> None:
    for key, value in managed.items():
        current = target.get(key)
        if isinstance(current, MutableMapping) and isinstance(value, MutableMapping):
            merge(current, value)
        else:
            target[key] = value


def write_atomically(path: Path, text: str) -> None:
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            file.write(text)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except BaseException:
        os.unlink(temporary)
        raise


def main(arguments: list[str]) -> int:
    if len(arguments) != 2:
        print("Usage: merge-toml <managed.toml> <target.toml>", file=sys.stderr)
        return 2
    managed_path, target_path = Path(arguments[0]), Path(arguments[1])
    try:
        managed = parse(managed_path)
        target = parse(target_path) if target_path.exists() else tomlkit.document()
    except ParseError as error:
        print(error, file=sys.stderr)
        return 1
    merge(target, managed)
    write_atomically(target_path, tomlkit.dumps(target))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
