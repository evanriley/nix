#!/usr/bin/env python3
"""Desktop helpers for niri and umbriel: scratchpad terminals, power menu,
monitor power, screenshots, suspend inhibitor."""

import argparse
import json
import os
import subprocess
import sys
import time

SCRATCH_APPS = {
    "btop": ("scratch_btop", ["foot", "--app-id=scratch_btop", "btop"]),
    "rmpc": ("scratch_rmpc", ["foot", "--app-id=scratch_rmpc", "rmpc"]),
}
SLEEP_INHIBIT_UNIT = "sleep-inhibit.service"
SCREENSHOT_DIR = os.path.expanduser("~/Pictures/Screenshots")


class CompositorError(Exception):
    pass


def compositor():
    """The running compositor, from the IPC socket its session exports."""
    if os.environ.get("NIRI_SOCKET"):
        return "niri"
    if os.environ.get("UMBRIEL_SOCKET"):
        return "umbriel"
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    display = os.environ.get("WAYLAND_DISPLAY")
    if runtime_dir and display and os.path.exists(f"{runtime_dir}/umbriel-{display}.sock"):
        return "umbriel"
    raise CompositorError("no niri or umbriel socket found; expected NIRI_SOCKET, "
                          "UMBRIEL_SOCKET or WAYLAND_DISPLAY from a running session")


def umbriel_json(command):
    result = subprocess.run(["umbriel", command, "--json"],
                            capture_output=True, check=True, text=True, timeout=5)
    return json.loads(result.stdout)


def umbriel_action(action):
    return subprocess.run(["umbriel", "msg", action], check=False).returncode


def niri_json(command):
    result = subprocess.run(["niri", "msg", "--json", command],
                            capture_output=True, check=True, text=True, timeout=5)
    return json.loads(result.stdout)


def niri_action(*args):
    return subprocess.run(["niri", "msg", "action", *args], check=False).returncode


def launch_and_wait(command, find):
    """Start command and return the window find() reports, or None after 3 seconds."""
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + 3
    window = None
    while window is None and time.monotonic() < deadline:
        time.sleep(0.1)
        window = find()
    return window


def scratch(name):
    if compositor() == "niri":
        return scratch_niri(name)
    return scratch_umbriel(name)


def scratch_niri(name):
    """Show the app on the focused workspace, or park it on "scratch" if focused."""
    app_id, command = SCRATCH_APPS[name]
    focused = next((w for w in niri_json("workspaces") if w["is_focused"]), None)
    if focused is None:
        print("desktopctl: no focused workspace", file=sys.stderr)
        return 1

    def find():
        return next((w for w in niri_json("windows") if w.get("app_id") == app_id), None)

    window = find()
    if window and window.get("is_focused") and focused.get("name") != "scratch":
        return niri_action("move-window-to-workspace", "--window-id", str(window["id"]),
                           "--focus", "false", "scratch")
    if window is None:
        window = launch_and_wait(command, find)
        if window is None:
            print(f"desktopctl: {app_id} did not appear within 3 seconds", file=sys.stderr)
            return 1
    window_id = str(window["id"])
    target = focused.get("name") or str(focused["idx"])
    result = niri_action("move-window-to-workspace", "--window-id", window_id,
                         "--focus", "false", target)
    return result or niri_action("focus-window", "--id", window_id)


def scratch_umbriel(name):
    """Toggle the app's scratchpad, starting the app first if needed.

    A window rule stores the app in the scratchpad named after it, hidden.
    """
    app_id, command = SCRATCH_APPS[name]

    def find():
        return next((w for w in umbriel_json("windows") if w.get("app_id") == app_id), None)

    if find() is None and launch_and_wait(command, find) is None:
        print(f"desktopctl: {app_id} did not appear within 3 seconds", file=sys.stderr)
        return 1
    return umbriel_action(f"scratchpad-toggle:{name}")


def screenshot(target):
    """Save a PNG under SCREENSHOT_DIR and copy it to the clipboard."""
    geometry = None
    if target == "region":
        selection = subprocess.run(["slurp"], capture_output=True, text=True, check=False)
        if selection.returncode != 0:
            return 1
        geometry = selection.stdout.strip()
    elif target == "window":
        if compositor() != "umbriel":
            print("desktopctl: screenshot window needs umbriel; use niri's screenshot-window",
                  file=sys.stderr)
            return 1
        window = next((w for w in umbriel_json("windows") if w.get("active")), None)
        if window is None:
            print("desktopctl: no focused window", file=sys.stderr)
            return 1
        geometry = f"{window['x']},{window['y']} {window['w']}x{window['h']}"
    os.makedirs(SCREENSHOT_DIR, exist_ok=True)
    path = os.path.join(SCREENSHOT_DIR, time.strftime("%Y-%m-%d_%H-%M-%S.png"))
    subprocess.run(["grim", *(["-g", geometry] if geometry else []), path], check=True)
    with open(path, "rb") as image:
        subprocess.run(["wl-copy", "--type", "image/png"], stdin=image, check=True)
    return 0


def menu(prompt, choices):
    result = subprocess.run(["fuzzel", "--dmenu", "--prompt", prompt],
                            input="\n".join(choices) + "\n", capture_output=True,
                            text=True, check=False)
    selected = result.stdout.strip()
    return selected if result.returncode == 0 and selected in choices else None


def power():
    choice = menu("Power: ", ["Lock", "Suspend", "Logout", "Reboot", "Power Off"])
    if choice == "Lock":
        return subprocess.run(["swaylock", "-f"], check=False).returncode
    if choice == "Suspend":
        return subprocess.run(["systemctl", "suspend"], check=False).returncode
    if choice and menu(f"Confirm {choice}: ", ["Yes", "No"]) == "Yes":
        if choice == "Logout":
            if compositor() == "niri":
                return niri_action("quit", "--skip-confirmation")
            return umbriel_action("session-quit:skip-confirmation")
        command = {"Reboot": "reboot", "Power Off": "poweroff"}[choice]
        return subprocess.run(["systemctl", command], check=False).returncode
    return 0


def monitors(state):
    """Power every monitor off or on.

    display-mode pauses while the marker exists: the monitor drops its mode list
    when powered off.
    """
    running = compositor()
    marker = os.path.join(os.environ["XDG_RUNTIME_DIR"], "monitors-off")
    if state == "off":
        open(marker, "a").close()
    if running == "niri":
        result = niri_action(f"power-{state}-monitors")
    else:
        result = umbriel_action(f"dpms-{state}")
    if state == "on" and os.path.exists(marker):
        os.remove(marker)
    return result


def sleep_inhibit_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", SLEEP_INHIBIT_UNIT],
                          check=False).returncode == 0


def sleep_inhibit(action):
    """Waybar custom module: status prints its JSON, toggle flips the unit."""
    if action == "status":
        active = sleep_inhibit_active()
        print(json.dumps({
            "text": "\uf185" if active else "\uf186",
            "class": "active" if active else "inactive",
            "tooltip": ("Automatic suspend blocked\nLocking and screen blanking remain enabled"
                        if active else
                        "Automatic suspend enabled\nClick to keep the computer awake"),
        }))
        return 0
    verb = "stop" if sleep_inhibit_active() else "start"
    result = subprocess.run(["systemctl", "--user", verb, SLEEP_INHIBIT_UNIT], check=False)
    subprocess.run(["systemctl", "--user", "kill", "--kill-whom=main", "--signal=RTMIN+10", "waybar.service"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("scratch").add_argument("app", choices=SCRATCH_APPS)
    commands.add_parser("power")
    commands.add_parser("monitors").add_argument("state", choices=("off", "on"))
    commands.add_parser("screenshot").add_argument("target", choices=("region", "screen", "window"))
    commands.add_parser("sleep-inhibit").add_argument("action", choices=("status", "toggle"))
    args = parser.parse_args()
    try:
        if args.command == "scratch":
            return scratch(args.app)
        if args.command == "power":
            return power()
        if args.command == "monitors":
            return monitors(args.state)
        if args.command == "screenshot":
            return screenshot(args.target)
        return sleep_inhibit(args.action)
    except (CompositorError, OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"desktopctl: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
