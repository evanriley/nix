cat >"$state_root/rmpc.ron.new" <<EOF
#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    background_color: "#$bg",
    header_background_color: "#$bg",
    modal_background_color: "#$bg_alt",
    text_color: "#$fg_max",
    preview_label_style: (fg: "#$yellow"),
    preview_metadata_group_style: (fg: "#$yellow", modifiers: "Bold"),
    highlighted_item_style: (fg: "#$bg", bg: "#$blue", modifiers: "Bold"),
    current_item_style: (fg: "#$bg", bg: "#$yellow", modifiers: "Bold"),
    borders_style: (fg: "#$border"),
    highlight_border_style: (fg: "#$blue"),
    tab_bar: (
        active_style: (fg: "#$bg", bg: "#$blue", modifiers: "Bold"),
        inactive_style: (fg: "#$muted"),
    ),
    progress_bar: (
        elapsed_style: (fg: "#$green"),
        thumb_style: (fg: "#$blue_bright"),
    ),
)
EOF
mv -f "$state_root/rmpc.ron.new" "$state_root/rmpc.ron"

cat >"$state_root/monobiome-alpine.kak.new" <<EOF
