fg_alt=#$fg_bright
blue=#$blue
green=#$green
green_alt=#$green_bright
magenta=#$orange
yellow=#$yellow
yellow_bright=#$yellow_bright
red=#$red
rust=#$orange
EOF
mv -f "$state_root/qutebrowser.conf.new" "$state_root/qutebrowser.conf"

cat >"$state_root/zathurarc.new" <<EOF
set default-bg "#$bg"
set default-fg "#$fg_max"
