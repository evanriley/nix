mv -f "$state_root/monobiome-alpine.kak.new" "$state_root/monobiome-alpine.kak"

printf '%s\n' "$mode" >"$state_root/mode.new"
mv -f "$state_root/mode.new" "$state_root/mode"

gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || true
gsettings set org.gnome.desktop.interface gtk-theme Adwaita 2>/dev/null || true

pkill -"$foot_signal" -x foot 2>/dev/null || true
pkill -USR1 -x nvim 2>/dev/null || true
pkill -USR2 -x waybar 2>/dev/null || true
swaync-client --reload-css >/dev/null 2>&1 || true

if pgrep -x qutebrowser >/dev/null 2>&1; then
    qutebrowser ':config-source' >/dev/null 2>&1 || true
fi

if tmux -L default list-sessions >/dev/null 2>&1; then
    tmux -L default source-file "$state_root/tmux.conf" >/dev/null 2>&1 || true
fi

for kak_session in $(kak -l 2>/dev/null || true); do
    printf 'source %s\n' "$state_root/monobiome-alpine.kak" |
        kak -p "$kak_session" >/dev/null 2>&1 || true
done

rmpc_pid=$(pgrep -x rmpc | head -1 || true)
if [ -n "$rmpc_pid" ]; then
    rmpc remote --pid "$rmpc_pid" set theme "$state_root/rmpc.ron" \
        >/dev/null 2>&1 || true
fi

restart_btop() {
    window=$(
        niri msg --json windows 2>/dev/null |
            jq -r 'first(.[] | select(.app_id == "scratch_btop") |
                [.pid, .id, .workspace_id, .is_focused] |
                map(tostring) | join(" ")) // empty'
    )
    [ -n "$window" ] || return 0
    read -r old_pid old_id workspace_id was_focused <<EOF
$window
EOF
    workspace=$(
        niri msg --json workspaces 2>/dev/null |
            jq -r --argjson id "$workspace_id" \
                'first(.[] | select(.id == $id) | (.name // (.idx | tostring))) // empty'
    )

    kill "$old_pid" 2>/dev/null || return 0
    wait_count=0
    while kill -0 "$old_pid" 2>/dev/null && [ "$wait_count" -lt 20 ]; do
        sleep 0.1
        wait_count=$((wait_count + 1))
    done
    kill -0 "$old_pid" 2>/dev/null && return 0

    niri msg action spawn -- foot --app-id=scratch_btop btop >/dev/null 2>&1 || return 0
    wait_count=0
    new_id=
    while [ "$wait_count" -lt 30 ]; do
        new_id=$(
            niri msg --json windows 2>/dev/null |
                jq -r --arg old "$old_id" \
                    'first(.[] | select(.app_id == "scratch_btop" and (.id | tostring) != $old) | .id) // empty'
        )
        [ -n "$new_id" ] && break
        sleep 0.1
        wait_count=$((wait_count + 1))
    done
    [ -n "$new_id" ] || return 0

    if [ -n "$workspace" ] && [ "$workspace" != scratch ]; then
        niri msg action move-window-to-workspace --window-id "$new_id" \
            --focus=false "$workspace" >/dev/null 2>&1 || true
    fi
    if [ "$was_focused" = true ]; then
        niri msg action focus-window --id "$new_id" >/dev/null 2>&1 || true
    fi
}

if [ -n "${NIRI_SOCKET:-}" ]; then
    restart_btop
fi

systemctl --user try-restart swayosd.service >/dev/null 2>&1 || true

exit 0
