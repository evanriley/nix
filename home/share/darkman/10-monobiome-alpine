set recolor-reverse-video true
EOF
mv -f "$state_root/zathurarc.new" "$state_root/zathurarc"

cat >"$state_root/btop.theme.new" <<EOF
theme[main_bg]="#$bg"
theme[main_fg]="#$fg_max"
theme[title]="#$blue"
theme[hi_fg]="#$red_bright"
