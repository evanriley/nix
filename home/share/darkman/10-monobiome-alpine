    minus-style = "#$red"
    minus-emph-style = "#$red_bright" bold
    line-numbers = true
    line-numbers-zero-style = "#$muted"
    line-numbers-minus-style = "#$red"
    line-numbers-plus-style = "#$green"
    whitespace-error-style = "#$bg" "#$red"
    blame-palette = "#$bg #$bg_alt #$selection #$border"
EOF
mv -f "$state_root/delta.gitconfig.new" "$state_root/delta.gitconfig"

cat >"$state_root/mpv.conf.new" <<EOF
osd-color='#$fg_max'
osd-border-color='#$bg'
osd-shadow-color='#$bg'
EOF
mv -f "$state_root/mpv.conf.new" "$state_root/mpv.conf"

cat >"$state_root/qutebrowser.conf.new" <<EOF
mode=$mode
bg=#$bg
bg_alt=#$bg_alt
