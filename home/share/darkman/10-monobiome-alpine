#!/bin/sh

set -eu

mode=${1:?expected light or dark}
case ${XDG_CURRENT_DESKTOP:-} in
*niri*) ;;
*)
    printf 'darkman: ignoring %s transition outside Niri\n' "$mode" >&2
    exit 0
    ;;
esac
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/darkman
mkdir -p "$state_root"

case "$mode" in
dark)
    bg=262626       # alpine l27: oklch(27% 0 0)
    bg_alt=333333   # alpine l32: oklch(32% 0 0)
    selection=404040 # alpine l37: oklch(37% 0 0)
    border=4d4d4d   # alpine l42: oklch(42% 0 0)
    muted=777777    # alpine l57: oklch(57% 0 0)
    fg_dim=b4b4b4   # alpine l77: oklch(77% 0 0)
    fg=c4c4c4       # alpine l82: oklch(82% 0 0)
    fg_bright=d4d4d4 # alpine l87: oklch(87% 0 0)
    fg_max=e4e4e4   # alpine l92: oklch(92% 0 0)
    red=e15344      # badlands l63: oklch(63% .1799 29)
    red_bright=fa8979 # badlands l75: oklch(75% .1402 29)
    orange=c38141   # chaparral l66: oklch(66% .1141 62.5)
    orange_bright=dfa36d # chaparral l76: oklch(76% .0996 62.5)
    yellow=9e9858   # savanna l67: oklch(67% .0856 104)
    yellow_bright=bdb778 # savanna l77: oklch(77% .0830 104)
    green=64a46e    # grassland l66: oklch(66% .1025 148)
    green_bright=87c28f # grassland l76: oklch(76% .0946 148)
    blue=5e8de4     # tundra l65: oklch(65% .1406 262)
    blue_bright=8ab1f8 # tundra l76: oklch(76% .1118 262)
    color_scheme=prefer-dark
    gtk_dark=true
    foot_signal=USR1
    ;;
light)
    bg=f5f5f5       # alpine l97: oklch(97% 0 0)
    bg_alt=e4e4e4   # alpine l92: oklch(92% 0 0)
    selection=d4d4d4 # alpine l87: oklch(87% 0 0)
    border=c4c4c4   # alpine l82: oklch(82% 0 0)
    muted=959595    # alpine l67: oklch(67% 0 0)
    fg_dim=5b5b5b   # alpine l47: oklch(47% 0 0)
    fg=4d4d4d       # alpine l42: oklch(42% 0 0)
    fg_bright=404040 # alpine l37: oklch(37% 0 0)
    fg_max=333333   # alpine l32: oklch(32% 0 0)
    red=db4b3d      # badlands l61: oklch(61% .1826 29)
    red_bright=b62920 # badlands l51: oklch(51% .1789 29)
    orange=a4672a   # chaparral l57: oklch(57% .1082 62.5)
    orange_bright=83501b # chaparral l48: oklch(48% .0948 62.5)
    yellow=7f7a42   # savanna l57: oklch(57% .0770 104)
    yellow_bright=615d2f # savanna l47: oklch(47% .0651 104)
    green=4e8757    # grassland l57: oklch(57% .0949 148)
    green_bright=396740 # grassland l47: oklch(47% .0808 148)
    blue=4d7ad1     # tundra l59: oklch(59% .1424 262)
    blue_bright=365da9 # tundra l49: oklch(49% .1290 262)
    color_scheme=default
    gtk_dark=false
    foot_signal=USR2
    ;;
*)
    printf 'darkman: unsupported mode: %s\n' "$mode" >&2
    exit 2
    ;;
esac

cat >"$state_root/palette.css.new" <<EOF
@define-color background #$bg;
@define-color background_alt #$bg_alt;
@define-color background_soft #$selection;
@define-color surface #$border;
@define-color selection #$selection;
@define-color border #$border;
@define-color muted #$muted;
@define-color foreground #$fg;
@define-color foreground_bright #$fg_max;
@define-color primary #$blue;
@define-color accent #$orange;
@define-color success #$green;
@define-color warning #$yellow;
@define-color error #$red;
EOF
mv -f "$state_root/palette.css.new" "$state_root/palette.css"

cat >"$state_root/foot.ini.new" <<EOF
[main]
initial-color-theme=$mode
EOF
mv -f "$state_root/foot.ini.new" "$state_root/foot.ini"

cat >"$state_root/fuzzel.ini.new" <<EOF
[colors]
background=${bg}fa
text=${fg_max}ff
prompt=${yellow}ff
placeholder=${muted}ff
border=${blue}ff
selection=${selection}ff
selection-text=${fg_max}ff
match=${red}ff
selection-match=${orange}ff
EOF
mv -f "$state_root/fuzzel.ini.new" "$state_root/fuzzel.ini"

cat >"$state_root/niri.kdl.new" <<EOF
layout {
    background-color "#$bg"
    border {
        active-color "#$blue"
        inactive-color "#$border"
        urgent-color "#$red"
    }
    tab-indicator {
        active-color "#$blue"
        inactive-color "#$border"
        urgent-color "#$red"
    }
}
overview { backdrop-color "#$bg_alt"; }
window-rule {
    match is-window-cast-target=true
    focus-ring { on; width 3; active-color "#$red"; inactive-color "#$red"; }
}
EOF
mv -f "$state_root/niri.kdl.new" "$state_root/niri.kdl"

cat >"$state_root/swaylock.conf.new" <<EOF
color=$bg
image=$HOME/.config/darkman/lockscreen-$mode.png
scaling=fill
font=Berkeley Mono
font-size=24
indicator-radius=72
indicator-thickness=8
indicator-caps-lock
show-failed-attempts
inside-color=${bg}f2
inside-clear-color=${bg_alt}f2
inside-caps-lock-color=${bg_alt}f2
inside-ver-color=${bg_alt}f2
inside-wrong-color=${bg_alt}f2
ring-color=$blue
ring-clear-color=$green
ring-caps-lock-color=$yellow
ring-ver-color=$blue_bright
ring-wrong-color=$red
key-hl-color=$orange
bs-hl-color=$red
separator-color=00000000
line-color=00000000
text-color=$fg_max
text-clear-color=$fg_max
text-caps-lock-color=$yellow
text-ver-color=$blue_bright
text-wrong-color=$red
layout-bg-color=${bg_alt}f2
layout-border-color=$border
layout-text-color=$fg_max
EOF
mv -f "$state_root/swaylock.conf.new" "$state_root/swaylock.conf"

cat >"$state_root/tmux.conf.new" <<EOF
set -g @theme-bg '#$bg'
set -g @theme-bg-alt '#$bg_alt'
set -g @theme-selection '#$selection'
set -g @theme-border '#$border'
set -g @theme-muted '#$muted'
set -g @theme-fg '#$fg_max'
set -g @theme-blue '#$blue'
set -g @theme-red '#$red'
EOF
mv -f "$state_root/tmux.conf.new" "$state_root/tmux.conf"

cat >"$state_root/fzf.fish.new" <<EOF
set -gx FZF_DEFAULT_OPTS \
    '--color=fg:#$fg_max,bg:#$bg,hl:#$red' \
    '--color=fg+:#$fg_max,bg+:#$selection,hl+:#$red_bright' \
    '--color=info:#$yellow,prompt:#$green,pointer:#$blue' \
    '--color=marker:#$green,spinner:#$yellow,header:#$blue'
EOF
mv -f "$state_root/fzf.fish.new" "$state_root/fzf.fish"

cat >"$state_root/delta.gitconfig.new" <<EOF
[delta]
    dark = $(test "$mode" = dark && printf true || printf false)
    light = $(test "$mode" = light && printf true || printf false)
    syntax-theme = none
    file-style = bold "#$blue"
    file-decoration-style = "#$border" ul
    hunk-header-style = file line-number syntax
    hunk-header-file-style = "#$fg"
    hunk-header-line-number-style = "#$orange"
    hunk-header-decoration-style = "#$border" box
    commit-style = raw
    commit-decoration-style = "#$border" box
    zero-style = "#$fg_max"
    plus-style = "#$green"
