{
  "include": [
    "~/.config/waybar/shared.jsonc"
  ],
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "custom/window"
  ],
  "ext/workspaces": {
    "format": "{name}",
    "sort-by-name": false,
    "sort-by-coordinates": true,
    "on-click": "activate"
  },
  "custom/window": {
    "exec": "~/.local/bin/desktopctl window-title",
    "escape": true,
    "max-length": 55,
    "restart-interval": 5
  }
}
