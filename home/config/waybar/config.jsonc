{
  "layer": "overlay",
  "exclusive": false,
  "start_hidden": true,
  "on-sigusr1": "toggle",
  "reload_style_on_change": true,
  "position": "bottom",
  "height": 30,
  "spacing": 8,
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "niri/window"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "custom/sleep-inhibit",
    "tray",
    "clock",
    "custom/notifications"
  ],
  "niri/workspaces": {
    "format": "{name}",
    "all-outputs": false
  },
  "niri/window": {
    "max-length": 55
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "on-click": "~/.local/bin/desktopctl scratch-btop"
  },
  "memory": {
    "format": "RAM {}%",
    "interval": 3,
    "tooltip-format": "{used:0.1f} GiB used"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol",
    "scroll-step": 2,
    "max-volume": 100
  },
  "custom/sleep-inhibit": {
    "exec": "~/.local/bin/desktopctl sleep-inhibit-status",
    "return-type": "json",
    "interval": 5,
    "signal": 10,
    "on-click": "~/.local/bin/desktopctl sleep-inhibit-toggle"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "format": "{:%a %H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },
  "custom/notifications": {
    "format": "Notifications",
    "on-click": "swaync-client -t",
    "tooltip": false
  }
}
