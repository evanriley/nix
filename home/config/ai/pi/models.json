{
  "providers": {
    "openrouter": {
      "apiKey": "!cat /run/agenix/openrouter-key",
      "modelOverrides": {
        "anthropic/claude-sonnet-5.5": {
          "contextWindow": 1000000,
          "maxTokens": 128000
        },
        "openai/gpt-6.1-sol": {
          "contextWindow": 1050000,
          "maxTokens": 128000,
          "compat": {
            "openRouterRouting": {
              "order": ["azure", "azure/us", "azure/eu"],
              "only": ["azure", "azure/us", "azure/eu"],
              "allow_fallbacks": false,
              "data_collection": "deny",
              "zdr": true
            }
          }
        },
        "deepseek/deepseek-v4.1-flash": {
          "contextWindow": 1048576,
          "maxTokens": 393216,
          "compat": {
            "openRouterRouting": {
              "order": ["morph", "novita", "coreweave", "makora", "crusoe", "parasail", "siliconflow"],
              "only": ["coreweave", "crusoe", "makora", "morph", "novita", "parasail", "siliconflow"],
              "allow_fallbacks": false,
              "quantizations": ["fp8"],
              "data_collection": "deny",
              "zdr": true
            }
          }
        }
      }
    },
    "coralbricks": {
      "name": "CoralBricks",
      "baseUrl": "https://inference.coralbricks.ai/v1",
      "api": "openai-completions",
      "compat": { "supportsLongCacheRetention": true },
      "apiKey": "!cat /run/agenix/coralbricks-key",
      "models": [
        {
          "id": "deepseek-v4.1-flash-fast",
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 393216,
          "cost": { "input": 0.01, "output": 1.2, "cacheRead": 0, "cacheWrite": 0.09 },
          "promptCache": { "short": 3600, "long": 3600 },
          "samplingParams": { "prompt_cache_options": { "ttl": "60m" } }
        }
      ]
    }
  }
}
