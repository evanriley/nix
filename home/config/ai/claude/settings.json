{
  "theme": "auto",
  "autoMode": {
    "environment": [
      "Treat every repository as public unless its project settings say otherwise",
      "Repository trust, sensitive paths and deployment boundaries come from project settings",
      "No organization, cloud provider, deployment target or internal service is globally configured",
      "Assume an ordinary developer machine with open internet access"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(git push --force:*)"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" }
  },
  "autoCompactWindow": 200000,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "agent-notify" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "agent-notify" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "agent-no-kill" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "agent-format" }]
      }
    ]
  }
}
