#!/bin/sh

set -eu

case "${1:-}" in
    scape)
        sink_match="alsa_output.usb-Fractal_Fractal_Scape_Dongle_"
        ;;
    dx5)
        sink_match="alsa_output.usb-Topping_DX5_II-"
        ;;
    *)
        echo "usage: scapectl-audio {scape|dx5}" >&2
        exit 2
        ;;
esac

sink_id=$(
    wpctl status --name | awk -v needle="$sink_match" '
        index($0, needle) {
            for (i = 1; i <= NF; i++) {
                if (index($i, needle)) {
                    id = $(i - 1)
                    sub(/\.$/, "", id)
                    print id
                    exit
                }
            }
        }
    '
)

if [ -z "$sink_id" ]; then
    echo "scapectl-audio: PipeWire sink not found: $sink_match" >&2
    exit 1
fi

wpctl set-default "$sink_id"
