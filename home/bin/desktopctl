#!/usr/bin/env python3
"""niri helpers: scratchpad terminals, power menu, suspend inhibitor."""

import argparse
import json
import subprocess
import sys
import time

SCRATCH_APPS = {
    "btop": ("scratch_btop", ["foot", "--app-id=scratch_btop", "btop"]),
    "rmpc": ("scratch_rmpc", ["foot", "--app-id=scratch_rmpc", "rmpc"]),
}
SLEEP_INHIBIT_UNIT = "sleep-inhibit.service"


def niri_json(command):
    result = subprocess.run(["niri", "msg", "--json", command],
                            capture_output=True, check=True, text=True, timeout=5)
    return json.loads(result.stdout)


def niri_action(*args):
    return subprocess.run(["niri", "msg", "action", *args], check=False).returncode


def scratch(name):
    """Show the app on the focused workspace, or park it on "scratch" if focused."""
    app_id, command = SCRATCH_APPS[name]
    focused = next((w for w in niri_json("workspaces") if w["is_focused"]), None)
    if focused is None:
        print("desktopctl: no focused workspace", file=sys.stderr)
        return 1

    def find():
        return next((w for w in niri_json("windows") if w.get("app_id") == app_id), None)

    window = find()
    if window and window.get("is_focused") and focused.get("name") != "scratch":
        return niri_action("move-window-to-workspace", "--window-id", str(window["id"]),
                           "--focus", "false", "scratch")
    if window is None:
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        deadline = time.monotonic() + 3
        while window is None and time.monotonic() < deadline:
            time.sleep(0.1)
            window = find()
        if window is None:
            print(f"desktopctl: {app_id} did not appear within 3 seconds", file=sys.stderr)
            return 1
    window_id = str(window["id"])
    target = focused.get("name") or str(focused["idx"])
    result = niri_action("move-window-to-workspace", "--window-id", window_id,
                         "--focus", "false", target)
    return result or niri_action("focus-window", "--id", window_id)


def menu(prompt, choices):
    result = subprocess.run(["fuzzel", "--dmenu", "--prompt", prompt],
                            input="\n".join(choices) + "\n", capture_output=True,
                            text=True, check=False)
    selected = result.stdout.strip()
    return selected if result.returncode == 0 and selected in choices else None


def power():
    choice = menu("Power: ", ["Lock", "Suspend", "Logout", "Reboot", "Power Off"])
    if choice == "Lock":
        return subprocess.run(["swaylock", "-f"], check=False).returncode
    if choice == "Suspend":
        return subprocess.run(["systemctl", "suspend"], check=False).returncode
    if choice and menu(f"Confirm {choice}: ", ["Yes", "No"]) == "Yes":
        if choice == "Logout":
            return niri_action("quit", "--skip-confirmation")
        command = {"Reboot": "reboot", "Power Off": "poweroff"}[choice]
        return subprocess.run(["systemctl", command], check=False).returncode
    return 0


def sleep_inhibit_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", SLEEP_INHIBIT_UNIT],
                          check=False).returncode == 0


def sleep_inhibit(action):
    """Waybar custom module: status prints its JSON, toggle flips the unit."""
    if action == "status":
        active = sleep_inhibit_active()
        print(json.dumps({
            "text": "\uf185" if active else "\uf186",
            "class": "active" if active else "inactive",
            "tooltip": ("Automatic suspend blocked\nLocking and screen blanking remain enabled"
                        if active else
                        "Automatic suspend enabled\nClick to keep the computer awake"),
        }))
        return 0
    verb = "stop" if sleep_inhibit_active() else "start"
    result = subprocess.run(["systemctl", "--user", verb, SLEEP_INHIBIT_UNIT], check=False)
    subprocess.run(["pkill", "--signal", "RTMIN+10", "--exact", "waybar"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("scratch").add_argument("app", choices=SCRATCH_APPS)
    commands.add_parser("power")
    commands.add_parser("sleep-inhibit").add_argument("action", choices=("status", "toggle"))
    args = parser.parse_args()
    try:
        if args.command == "scratch":
            return scratch(args.app)
        if args.command == "power":
            return power()
        return sleep_inhibit(args.action)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"desktopctl: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
