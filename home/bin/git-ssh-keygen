#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import sys

args = sys.argv[1:]
if args[:2] == ["-Y", "sign"] and "-f" in args:
    key_index = args.index("-f") + 1
    if args[key_index] == "yubikey":
        try:
            devices = subprocess.run(
                ["ykman", "list", "--serials"],
                capture_output=True, text=True, check=True, timeout=10,
            ).stdout.split()
        except (OSError, subprocess.SubprocessError) as error:
            sys.exit(f"Cannot detect the signing YubiKey: {error}")
        keys = [
            Path.home() / ".ssh" / f"id_ed25519_sk_sign_{serial}"
            for serial in devices if serial.isdecimal()
        ]
        key = next((key for key in keys if key.is_file()), None)
        if key is None:
            sys.exit("Connect an enrolled YubiKey to sign this Git operation.")
        args[key_index] = str(key)

os.execvp("ssh-keygen", ["ssh-keygen", *args])
