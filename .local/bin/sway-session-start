#!/bin/sh
set -eu
export XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway XDG_SESSION_TYPE=wayland
unset NIRI_SOCKET
systemctl --user unset-environment NIRI_SOCKET
dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE NIRI_SOCKET=
systemctl --user start swaync.service
systemctl --user restart darkman.service
systemctl --user stop xdg-desktop-portal-gnome.service
systemctl --user restart xdg-desktop-portal-gtk.service xdg-desktop-portal-wlr.service xdg-desktop-portal.service
