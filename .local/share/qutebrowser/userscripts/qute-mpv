#!/bin/sh

set -eu

url=${1:?missing media URL}
log_dir=${XDG_CACHE_HOME:-$HOME/.cache}/mpv
mkdir -p "$log_dir"

printf '%s\n' "$url" >"$log_dir/qutebrowser-url.log"

# Keep the window available on extraction errors and retain a useful log.
exec mpv \
    --idle=once \
    --force-window=immediate \
    --log-file="$log_dir/qutebrowser.log" \
    -- "$url"
